{
  "id": "big-banner",
  "code": "C-04",
  "kind": "addon",
  "name": "Big banner text",
  "family": "screen-messages",
  "oneLiner": "Phase, wave and result moments ('PLAYER PHASE', 'WAVE 2', 'STAGE CLEAR', 'VICTORY') get large chunky shaded letters that slide in over a translucent full-width band, hold, and wipe out in about 1.4 s; each kind has its own colours, banners queue so they never overlap, and the host can read a flag to hold input while one plays.",
  "fits": [
    "tactics / strategy RPG",
    "turn-based RPG battle",
    "wave-based action and shooters",
    "beat-'em-up",
    "arcade platformer (stage start / clear)",
    "puzzle (level clear)",
    "monster battler"
  ],
  "notFor": [
    "dialogue or tutorial text (needs wrapping and a window, not a banner)",
    "constant HUD labels (turn counter, score)",
    "games with dozens of announcements a minute (use a small ticker instead)"
  ],
  "interfaces": {
    "time": "any",
    "coords": "screen",
    "layer": "ui",
    "needs": [
      "phase / wave / stage / result transitions in update logic (call show once per moment)",
      "a fixed 60 Hz update step (the banner's only clock)",
      "the play field size in native px, HUD excluded",
      "optional: ui rects to keep clear (HUD windows, menus, captions)"
    ],
    "provides": [
      "busy flag: input should wait while a blocking banner plays",
      "band rectangle on screen, for other overlays to avoid",
      "onStart / onEnd events per banner"
    ]
  },
  "params": [
    { "key": "enter", "label": "Enter", "type": "select", "options": ["slide", "scale", "drop", "wipe"], "default": "slide" },
    { "key": "exit", "label": "Exit", "type": "select", "options": ["wipe", "slide", "fade"], "default": "wipe" },
    { "key": "enterMs", "label": "Enter (ms)", "type": "range", "min": 120, "max": 500, "step": 10, "default": 260 },
    { "key": "holdMs", "label": "Hold (ms)", "type": "range", "min": 300, "max": 1500, "step": 50, "default": 900 },
    { "key": "exitMs", "label": "Exit (ms)", "type": "range", "min": 120, "max": 500, "step": 10, "default": 260 },
    { "key": "stagger", "label": "Letter stagger, drop (ms)", "type": "range", "min": 0, "max": 80, "step": 5, "default": 35 },
    { "key": "size", "label": "Letter size", "type": "select", "options": ["1", "2", "3"], "default": "2" },
    { "key": "band", "label": "Band opacity", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.72 },
    { "key": "position", "label": "Position", "type": "select", "options": ["upper", "center", "lower"], "default": "center" },
    { "key": "block", "label": "Blocks input", "type": "select", "options": ["on", "off"], "default": "on" },
    { "key": "queue", "label": "Overlap", "type": "select", "options": ["queue", "replace"], "default": "queue" },
    { "key": "glint", "label": "Glint", "type": "select", "options": ["on", "off"], "default": "on" }
  ],
  "variants": [
    { "name": "Tactics phase", "params": { "enter": "slide", "exit": "wipe", "enterMs": 260, "holdMs": 900, "exitMs": 260, "size": "2", "position": "center" } },
    { "name": "Arcade drop-in", "params": { "enter": "drop", "stagger": 40, "exit": "slide", "holdMs": 700, "size": "3", "position": "upper" } },
    { "name": "Quick, out of the way", "params": { "enter": "wipe", "exit": "fade", "enterMs": 160, "holdMs": 500, "exitMs": 160, "size": "1", "band": 0.5, "block": "off" } },
    { "name": "Punchy pop", "params": { "enter": "scale", "exit": "wipe", "enterMs": 300, "holdMs": 800, "size": "3", "queue": "replace" } }
  ],
  "assets": [
    "module/big-banner.js: the element as one dependency-free script (global GameDNA_BigBanner): bold 5x7 display font scaled 1-3x, band, motion, queue, placement, drawing",
    "no image or audio files"
  ],
  "status": "draft",
  "module": {
    "file": "module/big-banner.js",
    "global": "GameDNA_BigBanner",
    "version": "1.0.0",
    "docs": "module/README.md"
  }
}
