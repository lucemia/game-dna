{
  "id": "grid-range-path",
  "code": "B-01",
  "name": "Grid movement range + path arrow",
  "family": "B: map & movement",
  "oneLiner": "Select a unit on a tile map to see every tile it can reach (blue, terrain-cost aware) and every tile it can strike (red); a segmented arrow follows the cursor along the cheapest path and the unit walks it tile by tile on confirm.",
  "fits": [
    "grid tactics",
    "tactical RPG",
    "turn-based wargame",
    "board-game adaptations",
    "roguelike tactics"
  ],
  "notFor": [
    "real-time action",
    "free (non-grid) movement",
    "isometric height maps without a flat-grid fallback",
    "hex grids (needs a neighbour rewrite)"
  ],
  "interfaces": {
    "time": "turn",
    "coords": "grid",
    "layer": "ui",
    "needs": [
      "tile grid size and tile size in px",
      "terrain id per tile + table {name, moveCost (99 = impassable), def, avo}",
      "unit list {name, side, x, y, hp, maxHp}",
      "input: direction held/pressed, confirm, cancel, pointer tile",
      "camera offset (or permission to drive it)",
      "a fixed-step update (60 Hz) and a draw pass between ground and units"
    ],
    "provides": [
      "event unitMoved {unit, from, to, path}",
      "event selectionCancelled {unit}",
      "event moveUndone {unit}",
      "data reachable set, stoppable set, attack-fringe set for the selected unit",
      "data current path [{x,y}] and its cost",
      "data cursor tile (drawn position, including mid-slide)"
    ]
  },
  "params": [
    {
      "key": "move",
      "label": "Move points",
      "type": "int",
      "min": 3,
      "max": 9,
      "step": 1,
      "default": 5
    },
    {
      "key": "range",
      "label": "Weapon range",
      "type": "select",
      "options": [
        "1",
        "1-2",
        "2"
      ],
      "default": "1"
    },
    {
      "key": "costs",
      "label": "Terrain move costs",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "key": "overlay",
      "label": "Overlay style",
      "type": "select",
      "options": [
        "solid",
        "pulsing",
        "checker"
      ],
      "default": "pulsing"
    },
    {
      "key": "repeat",
      "label": "Cursor repeat speed",
      "type": "select",
      "options": [
        "slow",
        "normal",
        "fast"
      ],
      "default": "normal"
    },
    {
      "key": "res",
      "label": "Native resolution",
      "type": "select",
      "options": [
        "240x160",
        "256x224"
      ],
      "default": "240x160"
    }
  ],
  "variants": [
    {
      "name": "Handheld melee (default)",
      "params": {
        "move": 5,
        "range": "1",
        "costs": "on",
        "overlay": "pulsing",
        "repeat": "normal",
        "res": "240x160"
      }
    },
    {
      "name": "Console skirmisher",
      "params": {
        "move": 7,
        "range": "1-2",
        "costs": "on",
        "overlay": "checker",
        "repeat": "normal",
        "res": "256x224"
      }
    },
    {
      "name": "Archer on open ground",
      "params": {
        "move": 5,
        "range": "2",
        "costs": "off",
        "overlay": "solid",
        "repeat": "normal",
        "res": "240x160"
      }
    },
    {
      "name": "Snappy cursor",
      "params": {
        "move": 6,
        "range": "1",
        "costs": "on",
        "overlay": "pulsing",
        "repeat": "fast",
        "res": "240x160"
      }
    }
  ],
  "assets": "none: all art (terrain, units, font, windows, arrow, cursor) is drawn by code in demo/index.html",
  "status": "draft",
  "delivery": {
    "version": "v1",
    "module": "module/grid-range-path.js",
    "global": "GameDNA_GridRange",
    "readme": "module/README.md"
  },
  "kind": "system",
  "starter": "starter/index.html",
  "starterReadme": "starter/README.md"
}
