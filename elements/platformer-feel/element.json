{
  "id": "platformer-feel",
  "code": "B-08",
  "name": "Platformer movement feel",
  "kind": "system",
  "family": "B: map & movement",
  "oneLiner": "Side-view hero movement and tile collision that feels good: acceleration curves on the ground and in the air, variable jump height, coyote time, jump buffering, apex hang, terminal fall speed, an 8- or 4-way dash that refills on landing, wall slide and wall jump, one-way platforms, ceiling-corner and ledge-lip correction, and sub-pixel positions drawn on whole pixels; every number is a parameter with presets, and a live overlay shows the jump arc, the forgiveness windows and the velocity.",
  "fits": [
    "side-view platformers",
    "action platformers with a dash",
    "metroidvania-style exploration",
    "precision / speedrun platformers",
    "side-scrolling action games with jumping"
  ],
  "notFor": [
    "top-down games (no gravity axis)",
    "slopes and curved ground (the tile map is square tiles and one-way tiles only)",
    "physics-driven bodies (ragdolls, rolling balls, ropes)",
    "vehicles and swimming"
  ],
  "interfaces": {
    "time": "realtime",
    "coords": "side",
    "layer": "actor",
    "needs": [
      "a tile map query tileAt(tx, ty) -> solid | oneway | empty, in world px tiles (hazards stay the game's)",
      "a fixed 60 Hz update step (also used by ?t= fast-forward and autoplay) where the hero used to move",
      "the game's input per step: left, right, up, down, jump held, jump pressed since last step, dash held / pressed (latched: a 0 ms tap counts)",
      "the hero's hitbox size and start position; places that move the hero directly (respawn, knockback, enemy bounce) routed to reset / knock / bounce",
      "optional: a free dash key"
    ],
    "provides": [
      "hero position (whole px) with sub-pixel remainder, velocity, onGround, facing, pose (idle run jump apex fall land dash wallslide hurt)",
      "events: jump (ground / coyote / buffered / wall), cut, apex, land, dash, dashEnd, refill, wallSlide, wallJump, corner, ledge, drop, bonk",
      "data: windows() coyote / buffer / dash state, squash() for squash and stretch, predict() jump arcs, anchor(camX, camY) for effects",
      "drawing: dust and dash after-images (drawFx), a stand-in hero (drawBody), the feel overlay (drawOverlay) and its UI rect",
      "stats: jumps by kind, dashes, wall jumps, corner and ledge nudges, embedded steps (0 = no tunnelling)"
    ]
  },
