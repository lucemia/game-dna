{
  "id": "weather-particles",
  "code": "E-06",
  "name": "Weather & ambient particles",
  "kind": "addon",
  "family": "ambient-fx",
  "oneLiner": "Seeded weather drawn in three depth layers behind and in front of the sprites: rain that splashes on the game's own ground line, snow, drifting dust motes, fireflies that glow at night and fluttering leaves, pushed by a gusting wind, cross-fading from one weather to the next, coloured by the skin, capped by a particle budget, kept off the UI, and identical frame for frame at the same clock.",
  "fits": [
    "platformer",
    "side-scrolling action",
    "top-down adventure / action RPG",
    "side-view RPG battle",
    "town and overworld screens",
    "title and menu screens",
    "tactics / strategy maps (back layer only)"
  ],
  "notFor": [
    "games where weather changes rules (wet tiles, visibility, slippery ground): this is look only; the game owns the rules",
    "screens with dense text the particles would cross (use uiRects, or front 0)",
    "3D or isometric scenes that need particles placed in depth by world height"
  ],
  "interfaces": {
    "time": "realtime",
    "coords": "side",
    "layer": "fx",
    "needs": [
      "fixed 60 Hz step to advance the weather clock (the same step ?t= fast-forward runs)",
      "camera offset in world px (x, optionally y) from the game's draw pass",
      "draw slot behind the sprites (after the background) and one after them, before the HUD",
      "optional: ground line per screen x (top of the ground under each column, null over pits) so rain splashes and leaves land on it",
      "optional: ui rects (HUD, windows, dialog) the particles must keep clear"
    ],
    "provides": [
      "weather layers behind and in front of the sprites",
      "current wind in px/s (for swaying grass or flags)",
      "per-layer particle counts and the drawn particle rects (for tests and other overlays)"
    ]
  },
  "params": [
    {
      "key": "weather",
      "label": "Weather",
      "type": "select",
      "options": [
        "rain",
        "snow",
        "leaves",
        "dust",
        "fireflies",
        "none"
      ],
      "default": "rain"
    },
    {
      "key": "density",
      "label": "Density",
      "type": "range",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "intensity",
      "label": "Intensity",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.5
    },
    {
      "key": "wind",
      "label": "Wind",
      "type": "range",
      "min": -2,
      "max": 2,
      "step": 0.1,
      "default": 0.4
    },
    {
      "key": "gust",
      "label": "Gusts",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.35
    },
    {
      "key": "parallax",
      "label": "Depth parallax",
      "type": "range",
      "min": 0,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "front",
      "label": "Share in front of sprites",
      "type": "range",
      "min": 0,
      "max": 0.6,
      "step": 0.05,
      "default": 0.25
    },
    {
      "key": "night",
      "label": "Night glow",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0
    },
    {
      "key": "shade",
      "label": "Storm shade",
      "type": "range",
      "min": 0,
      "max": 0.5,
      "step": 0.05,
      "default": 0
    },
    {
      "key": "fade",
      "label": "Cross-fade (ms)",
      "type": "range",
      "min": 0,
      "max": 6000,
      "step": 100,
      "default": 1500
    },
    {
      "key": "cap",
      "label": "Particle budget",
      "type": "range",
      "min": 20,
      "max": 400,
      "step": 10,
      "default": 180
    },
    {
      "key": "splash",
      "label": "Rain splashes",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "key": "uiMode",
      "label": "Over UI rects",
      "type": "select",
      "options": [
        "hide",
        "dim"
      ],
      "default": "hide"
    }
  ],
  "variants": [
    {
      "name": "Drizzle",
      "params": {
        "weather": "rain",
        "intensity": 0.2,
        "density": 0.7,
        "wind": 0.2
      }
    },
    {
      "name": "Storm",
      "params": {
        "weather": "rain",
        "intensity": 1,
        "density": 1.6,
        "wind": 1.2,
        "gust": 0.8,
        "shade": 0.25,
        "front": 0.35
      }
    },
    {
      "name": "Blizzard",
      "params": {
        "weather": "snow",
        "intensity": 0.9,
        "density": 1.6,
        "wind": 1.3,
        "gust": 0.7,
        "shade": 0.1
      }
    },
    {
      "name": "Quiet snowfall",
      "params": {
        "weather": "snow",
        "intensity": 0.25,
        "wind": 0.1,
        "gust": 0.1
      }
    },
    {
      "name": "Autumn gusts",
      "params": {
        "weather": "leaves",
        "wind": 1.1,
        "gust": 0.7,
        "density": 1.2
      }
    },
    {
      "name": "Dusty hall",
      "params": {
        "weather": "dust",
        "wind": 0.1,
        "gust": 0.1,
        "density": 1.3,
        "front": 0.3
      }
    },
    {
      "name": "Firefly night",
      "params": {
        "weather": "fireflies",
        "night": 1,
        "density": 1.4,
        "wind": 0.1,
        "gust": 0.15
      }
    }
  ],
  "assets": [
    "module/weather-particles.js: the element as one dependency-free script (global GameDNA_Weather): stateless seeded particle fields for five weathers, analytic gusting wind, depth layers, cross-fade, budget, UI avoidance, pixel and smooth drawing",
    "no image or audio files"
  ],
  "status": "draft",
  "module": {
    "file": "module/weather-particles.js",
    "global": "GameDNA_Weather",
    "version": "1.0.0",
    "docs": "module/README.md",
    "skin": "optional: skins/skin-api.js + skins/pixel16.js before it"
  }
}
