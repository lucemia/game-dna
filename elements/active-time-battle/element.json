{
  "id": "active-time-battle",
  "code": "A-01",
  "kind": "system",
  "name": "Active-time gauge battle",
  "family": "Battle flow",
  "oneLiner": "Every combatant's gauge fills in real time at a speed-based rate; a full hero gauge opens that hero's command window, and in Active mode enemies keep acting while you choose.",
  "fits": [
    "side-view party RPG battle",
    "turn-based battle that should feel urgent",
    "tactics skirmish with real-time pressure",
    "monster-taming battle",
    "dungeon crawler encounters"
  ],
  "notFor": [
    "action combat with direct movement",
    "strict alternating turns where speed must not matter",
    "card battlers with energy per turn",
    "real-time strategy with many units"
  ],
  "interfaces": {
    "time": "tick",
    "coords": "side",
    "layer": "ui",
    "needs": [
      "combatant list: id, side (party/enemy), speed 10-60, alive flag",
      "a 60 Hz tick (or delta time converted to ticks)",
      "startAction(action) that plays one action and reports actionDone",
      "enemy AI choose(enemy) -> action",
      "command menu that can be opened for one hero and returns an action or 'defend'",
      "status flags haste / slow per combatant"
    ],
    "provides": [
      "gauge 0..1 per combatant",
      "event heroReady(hero) and a FIFO ready queue",
      "event enemyReady(enemy)",
      "shared FIFO action queue (one action animates at a time)",
      "clockRunning flag (false in Wait mode while a menu is open)",
      "gauge state per combatant: charge / ready / queued / acting / dead"
    ]
  },
  "params": [
    {
      "key": "speed",
      "label": "Gauge speed multiplier",
      "type": "range",
      "min": 0.5,
      "max": 2,
      "step": 0.25,
      "default": 1
    },
    {
      "key": "mode",
      "label": "Battle mode",
      "type": "select",
      "options": [
        "active",
        "wait"
      ],
      "default": "active"
    },
    {
      "key": "party",
      "label": "Party size",
      "type": "range",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "key": "spd1",
      "label": "Hero 1 speed",
      "type": "range",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 32
    },
    {
      "key": "spd2",
      "label": "Hero 2 speed",
      "type": "range",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 24
    },
    {
      "key": "spd3",
      "label": "Hero 3 speed",
      "type": "range",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 44
    },
    {
      "key": "spd4",
      "label": "Hero 4 speed",
      "type": "range",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 28
    },
    {
      "key": "status",
      "label": "Party status",
      "type": "select",
      "options": [
        "none",
        "haste",
        "slow"
      ],
      "default": "none"
    },
    {
      "key": "res",
      "label": "Native resolution",
      "type": "select",
      "options": [
        "256x224",
        "240x160"
      ],
      "default": "256x224"
    },
    {
      "key": "enemyGauge",
      "label": "Enemy gauges",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    }
  ],
  "variants": [
    {
      "name": "Active (default)",
      "params": {}
    },
    {
      "name": "Wait mode",
      "params": {
        "mode": "wait"
      }
    },
    {
      "name": "Hasted party",
      "params": {
        "status": "haste"
      }
    },
    {
      "name": "Slowed party",
      "params": {
        "status": "slow"
      }
    },
    {
      "name": "Fast battle (x2)",
      "params": {
        "speed": 2
      }
    },
    {
      "name": "Handheld 240x160",
      "params": {
        "res": "240x160"
      }
    },
    {
      "name": "Solo hero",
      "params": {
        "party": 1,
        "spd1": 50
      }
    }
  ],
  "assets": "module/active-time-battle.js (global GameDNA_ATB, no dependencies; API in module/README.md). No external files. All art is procedural pixel art in code.",
  "status": "v1-module",
  "module": {
    "file": "module/active-time-battle.js",
    "global": "GameDNA_ATB",
    "version": "1.0.0"
  },
  "starter": "starter/index.html"
}
